# 1) Токен от @BotFather
BOT_TOKEN=

# 2) Админы по Telegram user ID (без чатов)
# Узнать свой ID: в боте /id
ADMIN_IDS=
LEADER_IDS=

# 3) Группа лидеров — бот шлёт сюда уведомления о новых impression
# Добавьте бота в группу → /chatid → вставьте ID
LEADER_CHAT_ID=

# Mini App
PORT=3000
DEV_PREVIEW=1
DEV_PREVIEW_USER_ID=
WEBAPP_URL=

# AI — OpenAI or compatible LiteLLM (e.g. Hecosys)
OPENAI_BASE_URL=https://ai-llm.hecosys.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Whisper (or compatible) for voice → text in the bot
OPENAI_TRANSCRIBE_MODEL=whisper-1

# MySQL (phpMyAdmin / EasyPanel)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=icf_watchmen
# Optional; default is watchmen_
MYSQL_TABLE_PREFIX=watchmen_
