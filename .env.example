# 1) Токен от @BotFather
BOT_TOKEN=

# 2) Опционально: фиксированные ID (fallback)
ADMIN_IDS=
LEADER_IDS=

# 3) Роли по членству в чатах (предпочтительно)
# Добавьте бота в группу → в группе /chatid → вставьте ID сюда
ADMIN_CHAT_ID=
LEADER_CHAT_ID=

# Mini App
PORT=3000
DEV_PREVIEW=1
DEV_PREVIEW_USER_ID=
WEBAPP_URL=

# AI — OpenAI или совместимый LiteLLM (например Hecosys)
OPENAI_BASE_URL=https://ai-llm.hecosys.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MySQL (phpMyAdmin / EasyPanel)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=icf_watchmen
# Optional; default is watchmen_
MYSQL_TABLE_PREFIX=watchmen_
